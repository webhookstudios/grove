#!/usr/bin/python3
import os
import sys

# Installed: /usr/share/spool/spool. From a checkout: the folder next to bin/.
here = os.path.dirname(os.path.realpath(__file__))
for base in (os.path.join(here, '..', 'share', 'spool'), os.path.join(here, '..'), here):
    if os.path.isdir(os.path.join(base, 'spool')):
        sys.path.insert(0, os.path.abspath(base))
        break

from spool.__main__ import main

sys.exit(main())
